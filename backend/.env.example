# Copy this file to .env.development (for local dev) and .env.production (for server)
# Never commit the real .env.development or .env.production files.

NODE_ENV=development          # or production

PORT=8000

# MongoDB connection string
# Dev:  use a separate DB name (e.g. school_erp_dev)
# Prod: use the real production DB
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>?appName=Cluster0

# JWT signing secret
# Dev:  any random string is fine
# Prod: generate with → node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here

# Comma-separated list of frontend origins allowed by CORS (only enforced in production)
# Example: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000

# Cloudinary (for homework file uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
